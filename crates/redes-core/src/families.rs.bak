        FamilyDef {
            key: "agua.tanque",
            code_prefix: "TQ",
            label: "Tanque / reservorio",
            category: Category::Agua,
            topo: TopoRole::Node,
            geom: GeomKind::Polygon,
            caps: caps::HYDRAULIC_NODE | caps::STRUCTURAL | caps::SOURCE | caps::REPORTABLE,
